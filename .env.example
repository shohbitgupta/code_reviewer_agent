# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real credentials.

# ── LLM backend ───────────────────────────────────────────────────────────────
# LITELLM → configs/model_config.json's "reviewer"/"judge"/"summarizer" entries,
#           via an OpenAI-SDK-compatible LiteLLM gateway (custom base_url below)
#           — default if MODEL_TYPE is unset
# FREE    → GLM 5.2 via tokenrouter (no cost, rate-limited)
# OPENAI  → OpenAI GPT-4o
# ANTHROPIC → Claude via Anthropic API
MODEL_TYPE=LITELLM

# ── API keys (provide the one matching your MODEL_TYPE) ───────────────────────
ZHIPUAI_API_KEY=       # GLM free tier key from platform.zhipuai.cn
OPENAI_API_KEY=        # OpenAI key (MODEL_TYPE=OPENAI); also the auth key for
                       # the "judge" role in configs/model_config.json
DEEPSEEK_API_KEY=      # Auth key for the "reviewer" and "summarizer" roles in
                       # configs/model_config.json (both DeepSeek models here)
ANTHROPIC_API_KEY=     # Anthropic key (MODEL_TYPE=ANTHROPIC)

# ── Embeddings ────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=        # Voyage AI key (voyage-code-3 model); fallback to OpenAI if unset

# ── GitHub integration (optional — only needed for PR comment posting) ────────
GITHUB_TOKEN=          # Personal access token with repo + pull_request scopes

# ── Budget guard (optional — 0 disables the corresponding cap) ────────────────
MAX_REVIEW_COST_USD=0  # Hard USD ceiling per review run
DAILY_BUDGET_USD=0     # Rolling 24h USD ceiling across all runs
